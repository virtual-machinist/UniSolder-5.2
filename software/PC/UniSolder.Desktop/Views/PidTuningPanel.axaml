<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniSolder.Desktop.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="UniSolder.Desktop.Views.PidTuningPanel"
             x:DataType="vm:PidTuningViewModel">

    <ScrollViewer Margin="20">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="16">
            <!-- Header & Action Bar -->
            <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Tune" Width="20" Height="20" Foreground="#A855F7" VerticalAlignment="Center" />
                            <TextBlock Text="PID Control Parameters" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>

                    <CheckBox Grid.Column="1" Content="Auto-Sync Changes" IsChecked="{Binding IsAutoSyncEnabled}" Foreground="#CBD5E1" Margin="0,0,16,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{Binding ReadParametersCommand}" Background="#334155" Foreground="#F8FAFC" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="Download" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Read from Device" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding WriteParametersCommand}" Background="#2563EB" Foreground="#FFFFFF" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="Upload" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Write to Device" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Parameters Sliders Card -->
            <Border Background="#1E293B" CornerRadius="8" Padding="20" BorderBrush="#334155" BorderThickness="1">
                <StackPanel Spacing="20">
                    <!-- Kp Parameter -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Kp (Proportional Gain)" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScaledKp, StringFormat='Kp = {0:F2} (Raw: {1})', FallbackValue='0.50'}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="32767" Value="{Binding RawKp}" Margin="0,6,0,0" />
                    </Grid>

                    <!-- Ki Parameter -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ki (Integral Gain)" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScaledKi, StringFormat='Ki = {0:F3} (Raw: {1})', FallbackValue='0.100'}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="32767" Value="{Binding RawKi}" Margin="0,6,0,0" />
                    </Grid>

                    <!-- DGain Parameter -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="DGain (Derivative Gain)" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DGain, StringFormat='DGain = {0}'}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="255" Value="{Binding DGain}" Margin="0,6,0,0" />
                    </Grid>

                    <!-- OVSGain Parameter -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="OVSGain (Overshoot Gain)" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OvsGain, StringFormat='OVSGain = {0}'}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding OvsGain}" Margin="0,6,0,0" />
                    </Grid>

                    <!-- Gain Parameter -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Gain (Loop Gain)" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Gain, StringFormat='Gain = {0}'}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="256" Value="{Binding Gain}" Margin="0,6,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UniSolder.Desktop.ViewModels"
        xmlns:views="using:UniSolder.Desktop.Views"
        xmlns:converters="using:UniSolder.Desktop.Converters"
        x:Class="UniSolder.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="UniSolder 5.2 - Cross-Platform Control &amp; Telemetry"
        Width="1150" Height="780"
        MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">
        <!-- Top Status & Control Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="14,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <!-- Connection Indicator Dot -->
                <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,10,0"
                         Fill="{Binding IsConnected, Converter={StaticResource ConnectionStatusBrushConverter}}"
                         VerticalAlignment="Center"/>

                <!-- Connection State Label -->
                <TextBlock Grid.Column="1" Text="{Binding ConnectionStatusText}"
                           FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>

                <!-- Operating Mode Badge -->
                <Border Grid.Column="2" Background="#334155" CornerRadius="4" Padding="8,3" Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OperatingModeText}" FontSize="12" Foreground="#CBD5E1"/>
                </Border>

                <!-- Hardware Device Info -->
                <TextBlock Grid.Column="3" Text="{Binding DeviceInfoText}"
                           FontSize="12" Foreground="#94A3B8"
                           VerticalAlignment="Center"/>

                <!-- I/O Packet Stats -->
                <TextBlock Grid.Column="4" Text="{Binding PacketStatsText}"
                           FontSize="12" Foreground="#94A3B8" Margin="0,0,20,0"
                           VerticalAlignment="Center"/>

                <!-- Live Stream Toggle Button -->
                <Button Grid.Column="5" Command="{Binding ToggleLiveStreamCommand}"
                        Background="#334155" Foreground="#F8FAFC"
                        Padding="12,6" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding IsLiveStreamActive, Converter={x:Null}, StringFormat='Live Stream: {0}'}" />
                    </StackPanel>
                </Button>

                <!-- Connect / Disconnect Button -->
                <Button Grid.Column="6" Command="{Binding ToggleConnectionCommand}"
                        Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold"
                        Padding="14,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IsConnected, Converter={x:Null}, StringFormat='{}{0}'}">
                        <!-- Fallback / Simple Content via Binding -->
                    </TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- Main Tab Content Area -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="10,6">
            <TabItem Header="📊 Real-Time Telemetry">
                <views:ChartPanel DataContext="{Binding ChartViewModel}" />
            </TabItem>
            <TabItem Header="🎛️ PID Calibration">
                <views:PidTuningPanel DataContext="{Binding PidViewModel}" />
            </TabItem>
            <TabItem Header="⚡ Firmware Flashing">
                <views:FirmwareFlashingDialog DataContext="{Binding FlashViewModel}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
